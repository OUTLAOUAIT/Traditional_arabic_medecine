# MongoDB Atlas or self-hosted MongoDB connection URI
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database and collection names
DATA_BASE=medecine
COLLECTION_NAME=fasls
CHUNKS_COLLECTION_NAME=chunks

# Optional override for the source fasls collection used by chunk ingestion
# FASLS_COLLECTION_NAME=fasls
