# MongoDB Atlas or self-hosted MongoDB connection URI
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database and collection names
DATA_BASE=medecine
COLLECTION_NAME=fasls
CHUNKS_COLLECTION_NAME=chunks
WEAVIATE_COLLECTION_NAME=TibbChunksBgeM3
# Leave both blank for local Docker. For Weaviate Cloud, set the REST endpoint
# and API key shown under "How to connect" in the Weaviate Cloud Console.
WEAVIATE_URL=
WEAVIATE_API_KEY=
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=8
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.8-flash

# Optional override for the source fasls collection used by chunk ingestion
# FASLS_COLLECTION_NAME=fasls
